NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/syncmate?retryWrites=true&w=majority
WEB_URL=http://localhost:5173
API_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5173,*
JWT_ACCESS_SECRET=replace_with_at_least_32_character_secret_key_syncmate_access
JWT_REFRESH_SECRET=replace_with_at_least_32_character_secret_key_syncmate_refresh
ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
MAX_GROUP_MEMBERS=5
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
DISABLE_SCHEDULER=false

# Optional Integrations (leave empty if not configured)
FIREBASE_SERVICE_ACCOUNT_JSON=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SyncMate <no-reply@syncmate.app>"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/integrations/google/callback
